// Legal Property Management System - Database Schema
// Purpose: High-integrity data model for Nigerian legal practitioners
// Security: PII fields (NIN, BVN) are stored encrypted at application level

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USER MODEL - The Legal Practitioners
// ============================================
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified DateTime?
  name          String?
  password      String   // Hashed with bcrypt
  role          UserRole @default(VIEWER)
  
  // Recovery System
  recoveryKey   String?  // Hashed with bcrypt
  mustChangePassword Boolean @default(false)
  
  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  auditLogs     AuditLog[]
  accounts      Account[]
  sessions      Session[]
  payments      Payment[]   // Payments recorded by this user
  expenses      Expense[]   // Expenses recorded by this user
  
  @@index([email])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN // Business Owner - Full system access
  MANAGER     // Head of Operations - Team management, approvals
  ASSOCIATE   // Can create/edit records
  VIEWER      // Read-only access
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

// Gender for proper pronoun usage in legal documents
enum Gender {
  MALE
  FEMALE
  CORPORATE  // Company/Organization
}

// ============================================
// CLIENT MODEL - The Landlords/Property Owners
// ============================================
model Client {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  phone     String
  address   String?
  
  // Banking Details - For Rent Remittance
  bankName      String?
  accountNumber String?
  accountName   String?
  
  // Verification Status
  verificationStatus VerificationStatus @default(PENDING)
  
  // Personal Details for Legal Documents
  title     String?  // Mr, Mrs, Dr, Chief, Engr, etc.
  gender    Gender   @default(MALE)
  
  // PII - Stored ENCRYPTED at application level
  // NEVER query raw BVN directly
  bvn       String?  // Bank Verification Number (Encrypted)
  passportUrl String? // Passport Photo URL
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  properties Property[]
  
  @@index([email])
  @@index([lastName])
  @@index([phone])
  @@map("clients")
}

// ============================================
// PROPERTY MODEL - The Legal Assets
// ============================================
model Property {
  id                 String                @id @default(cuid())
  address            String
  city               String
  state              NigerianState
  
  // Title Information
  titleType          TitleType
  registrationNumber String                @unique
  surveyNumber       String?
  plotNumber         String?
  
  // Property Details
  landArea           Float?                // In square meters
  buildingArea       Float?                // In square meters
  
  // Multi-Unit Support
  structureType      PropertyStructureType @default(SINGLE_UNIT)
  
  // Ownership
  ownerId            String
  owner              Client                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  // Verification Status
  verificationStatus VerificationStatus @default(PENDING)
  
  // Timestamps
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  
  // Relations
  units              PropertyUnit[]        // Multi-unit properties
  tenancies          Tenancy[]
  documents          Document[]
  expenses           Expense[]             // Property expenses
  maintenanceRequests MaintenanceRequest[] // Maintenance tickets
  
  
  @@index([ownerId])
  @@index([state])
  @@index([registrationNumber])
  @@map("properties")
}

enum TitleType {
  IRREVOCABLE_POWER_OF_ATTORNEY
  OTHER
}

enum PropertyStructureType {
  SINGLE_UNIT          // Single family house, bungalow, duplex
  BLOCK_OF_FLATS       // Multi-unit residential building
  SHOPPING_COMPLEX     // Multiple commercial units
  ESTATE               // Multiple buildings in a compound
  LAND                 // Undeveloped land
}

enum UnitType {
  ROOM_PARLOUR         // Room & Parlour (Nigerian style)
  SELF_CONTAIN         // Self-contained (Nigerian style)
  ONE_BEDROOM          // 1 Bedroom flat
  TWO_BEDROOM          // 2 Bedroom flat
  THREE_BEDROOM        // 3 Bedroom flat
  FOUR_BEDROOM         // 4 Bedroom flat
  DUPLEX               // Multi-level residential unit
  SHOP                 // Commercial shop unit
  WAREHOUSE            // Storage/warehouse unit
  PLOT_OF_LAND         // Subdivided land plot
  OFFICE               // Office space unit
}

enum NigerianState {
  ABIA
  ADAMAWA
  AKWA_IBOM
  ANAMBRA
  BAUCHI
  BAYELSA
  BENUE
  BORNO
  CROSS_RIVER
  DELTA
  EBONYI
  EDO
  EKITI
  ENUGU
  FCT
  GOMBE
  IMO
  JIGAWA
  KADUNA
  KANO
  KATSINA
  KEBBI
  KOGI
  KWARA
  LAGOS
  NASARAWA
  NIGER
  OGUN
  ONDO
  OSUN
  OYO
  PLATEAU
  RIVERS
  SOKOTO
  TARABA
  YOBE
  ZAMFARA
}

// ============================================
// PROPERTY UNIT MODEL - Individual Units within a Property
// ============================================
model PropertyUnit {
  id          String    @id @default(cuid())
  name        String    // e.g., "Flat 1", "Shop A", "Unit 2B"
  type        UnitType  // Type of unit (bedroom count, shop, etc.)
  
  // Unit Details
  bedrooms    Int?      // Number of bedrooms (for residential)
  bathrooms   Int?      // Number of bathrooms (for residential)
  marketRent  Decimal?  @db.Decimal(15, 2) // Asking rent for this unit
  
  // Relations
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  tenancies   Tenancy[] // Units can have multiple tenancies over time
  maintenanceRequests MaintenanceRequest[] // Maintenance tickets
  
  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([propertyId])
  @@index([type])
  @@map("property_units")
}

// ============================================
// TENANCY MODEL - The Lease Agreements
// ============================================
model Tenancy {
  id           String        @id @default(cuid())
  
  // Tenant Information
  tenantName   String
  tenantEmail  String?
  tenantPhone  String
  tenantPassportUrl String? // Tenant Passport Photo URL
  tenantTitle  String?      // Mr, Mrs, Dr, Chief, etc.
  tenantGender Gender @default(MALE)
  
  // Guarantor Details (Optional)
  guarantorName     String?
  guarantorPhone    String?
  guarantorEmail    String?
  guarantorAddress  String?
  
  // Next of Kin (Optional)
  nextOfKinName         String?
  nextOfKinPhone        String?
  nextOfKinRelationship String?
  
  // Lease Terms
  startDate    DateTime
  expiryDate   DateTime      // INDEXED for expiry tracking
  annualRent   Decimal       @db.Decimal(15, 2)
  status       TenancyStatus @default(ACTIVE)
  
  // Payment Terms
  paymentFrequency PaymentFrequency? @default(ANNUALLY)
  securityDeposit  Decimal?   @db.Decimal(15, 2)
  
  // Verification Status
  verificationStatus VerificationStatus @default(PENDING)
  
  // Relations
  propertyId   String
  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  
  unitId       String?       // Optional: For multi-unit properties
  unit         PropertyUnit? @relation(fields: [unitId], references: [id], onDelete: Restrict)
  
  payments     Payment[]     // Financial tracking
  expenses     Expense[]     // Expense tracking
  maintenanceRequests MaintenanceRequest[] // Maintenance tickets
  
  // Timestamps
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  @@index([propertyId])
  @@index([unitId])
  @@index([expiryDate])  // Critical for automated expiry alerts
  @@index([status])
  @@index([tenantName])
  @@map("tenancies")
}

enum TenancyStatus {
  ACTIVE          // Lease is currently active
  EXPIRED         // Lease has expired
  NOTICE_SERVED   // Notice to vacate has been served
  TERMINATED      // Lease was terminated early
  RENEWED         // Lease was renewed (historical record)
}

enum PaymentFrequency {
  ANNUALLY
  BI_ANNUALLY
  QUARTERLY
  MONTHLY
}

// ============================================
// DOCUMENT MODEL - Title Documents Storage
// ============================================
model Document {
  id         String   @id @default(uuid())
  url        String   // Supabase Storage URL
  name       String   // e.g., "CofO.pdf"
  type       String   // MIME type e.g., "application/pdf"
  
  // Relations
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  // Timestamps
  createdAt  DateTime @default(now())
  
  @@index([propertyId])
  @@map("documents")
}

// ============================================
// PAYMENT MODEL - Financial Transaction Tracking
// ============================================
model Payment {
  id           String        @id @default(cuid())
  
  // Payment Details
  amount       Decimal       @db.Decimal(15, 2)
  date         DateTime      // Payment date (can be backdated)
  type         PaymentType
  method       PaymentMethod
  reference    String?       // Bank reference, cheque number, etc.
  
  // Relations
  tenancyId    String
  tenancy      Tenancy       @relation(fields: [tenancyId], references: [id], onDelete: Restrict)
  
  recordedBy   String
  recordedByUser User        @relation(fields: [recordedBy], references: [id], onDelete: Restrict)
  
  // Audit Trail
  notes        String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  @@index([tenancyId])
  @@index([date])
  @@index([recordedBy])
  @@index([type])
  @@map("payments")
}

enum PaymentType {
  RENT              // Regular rent payment
  SERVICE_CHARGE    // Building maintenance fees
  LEGAL_FEE         // Lawyer's professional fees
  CAUTION           // Security deposit/caution fee
}

enum PaymentMethod {
  CASH              // Physical cash payment
  TRANSFER          // Bank transfer/wire transfer
  CHEQUE            // Bank cheque
}

// ============================================
// AUDIT LOG - The Integrity Layer
// ============================================
model AuditLog {
  id          String   @id @default(cuid())
  
  // Action Details
  action      String   // e.g., "CREATE_CLIENT", "UPDATE_PROPERTY"
  entityType  String   // e.g., "Client", "Property", "Tenancy"
  entityId    String   // ID of the affected record
  
  // Actor
  performedBy String
  user        User     @relation(fields: [performedBy], references: [id], onDelete: Cascade)
  
  // Context
  details     Json?    // Stores before/after snapshots
  ipAddress   String?
  userAgent   String?
  
  // Timestamp (immutable)
  timestamp   DateTime @default(now())
  
  @@index([entityType, entityId])
  @@index([performedBy])
  @@index([timestamp])
  @@map("audit_logs")
}

// ============================================
// NOTIFICATION LOG - Legal Proof of Delivery
// ============================================
model NotificationLog {
  id            String             @id @default(cuid())
  
  // Notification Details
  type          NotificationType
  recipient     String             // Email address or phone number
  subject       String?
  message       String             @db.Text
  
  // Delivery Status
  status        NotificationStatus @default(PENDING)
  sentAt        DateTime?
  deliveredAt   DateTime?
  failureReason String?
  
  // Related Entity (for tracking)
  entityType    String?            // e.g., "Tenancy"
  entityId      String?
  
  // Timestamps
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  
  @@index([recipient])
  @@index([status])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("notification_logs")
}

enum NotificationType {
  EMAIL
  SMS
  SYSTEM_ALERT
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

// ============================================
// NEXT-AUTH MODELS - Authentication
// ============================================
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// EXPENSE TRACKING - Property & Tenancy Costs
// ============================================
enum ExpenseCategory {
  REPAIR            // Plumbing, electrical, structural repairs
  AGENCY_FEE        // Lawyer/agent commission
  LEGAL_FEE         // Court fees, documentation
  UTILITY           // PHCN, water, generator fuel
  OTHER             // Miscellaneous expenses
}

model Expense {
  id          String          @id @default(cuid())
  amount      Decimal         @db.Decimal(15, 2)
  date        DateTime
  description String
  category    ExpenseCategory
  
  // Relations
  propertyId  String
  property    Property        @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  
  tenancyId   String?         // Optional - can be building-wide expense
  tenancy     Tenancy?        @relation(fields: [tenancyId], references: [id], onDelete: Restrict)
  
  recordedBy  String
  recordedByUser User         @relation(fields: [recordedBy], references: [id], onDelete: Restrict)
  
  // Timestamps
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  
  @@index([propertyId])
  @@index([tenancyId])
  @@index([date])
  @@index([category])
  @@map("expenses")
}

// ============================================
// MAINTENANCE REQUEST - Tenant Complaint Tracking
// ============================================
enum MaintenanceStatus {
  OPEN              // Just reported
  IN_PROGRESS       // Being worked on
  RESOLVED          // Fixed
  CLOSED            // Closed without resolution / declined
}

enum MaintenancePriority {
  LOW               // Minor inconvenience
  MEDIUM            // Needs attention soon
  HIGH              // Urgent - affects habitability
  URGENT            // Emergency - safety hazard
}

model MaintenanceRequest {
  id          String              @id @default(cuid())
  title       String
  description String              @db.Text
  status      MaintenanceStatus   @default(OPEN)
  priority    MaintenancePriority @default(MEDIUM)
  
  // Relations
  propertyId  String
  property    Property            @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  
  unitId      String?
  unit        PropertyUnit?       @relation(fields: [unitId], references: [id], onDelete: Restrict)
  
  tenancyId   String?             // Who reported it
  tenancy     Tenancy?            @relation(fields: [tenancyId], references: [id], onDelete: Restrict)
  
  // Timestamps
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  
  @@index([propertyId])
  @@index([status])
  @@index([priority])
  @@index([tenancyId])
  @@map("maintenance_requests")
}

// ============================================
// FIRM SETTINGS - Dynamic Branding & Localization
// ============================================
model FirmSettings {
  id             String   @id @default(cuid())
  firmName       String   @default("Ogodo, Ogodo & Co.")
  chambersName   String   @default("Beracah Chambers")
  address        String   @default("14 Ojeawere Street, Abakaliki, Ebonyi State")
  city           String   @default("Abakaliki")
  state          String   @default("Ebonyi")
  solicitorName  String   @default("K. O. Ogboso, Esq.")
  solicitorTitle String   @default("Legal Practitioner")
  
  // Timestamps
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@map("firm_settings")
}
